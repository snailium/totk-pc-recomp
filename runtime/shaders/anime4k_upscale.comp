// Anime4K Catmull-Rom bicubic upscale of the game's output to the swapchain size (runtime/vk_fsr.c).
// Scales the crop rectangle to the output resolution with edge preservation; stores RGB and luminance.
#version 450

precision highp float;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    vec4 view;   // crop width, crop height, source image width, source image height
    vec4 out_;   // output width, output height, crop x, crop y
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.out_.x) || p.y >= int(pc.out_.y)) return;

    // Crop space coordinates
    float crop_x = pc.out_.z + (float(p.x) + 0.5) * (pc.view.x / pc.out_.x);
    float crop_y = pc.out_.w + (float(p.y) + 0.5) * (pc.view.y / pc.out_.y);

    // Texel coordinates in source image
    vec2 tc = vec2(crop_x, crop_y) - 0.5;
    vec2 f = fract(tc);
    vec2 i = floor(tc);

    // 1D Catmull-Rom weights
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 tc12 = (i + 0.5 + w2 / max(w12, vec2(1e-5))) / pc.view.zw;
    vec2 tc0  = (i - 0.5) / pc.view.zw;
    vec2 tc3  = (i + 2.5) / pc.view.zw;

    vec2 min_uv = (pc.out_.zw + 0.5) / pc.view.zw;
    vec2 max_uv = (pc.out_.zw + pc.view.xy - 0.5) / pc.view.zw;

    tc0  = clamp(tc0,  min_uv, max_uv);
    tc12 = clamp(tc12, min_uv, max_uv);
    tc3  = clamp(tc3,  min_uv, max_uv);

    vec4 c = vec4(0.0);
    c += texture(src, vec2(tc0.x,  tc0.y )) * (w0.x  * w0.y);
    c += texture(src, vec2(tc12.x, tc0.y )) * (w12.x * w0.y);
    c += texture(src, vec2(tc3.x,  tc0.y )) * (w3.x  * w0.y);

    c += texture(src, vec2(tc0.x,  tc12.y)) * (w0.x  * w12.y);
    c += texture(src, vec2(tc12.x, tc12.y)) * (w12.x * w12.y);
    c += texture(src, vec2(tc3.x,  tc12.y)) * (w3.x  * w12.y);

    c += texture(src, vec2(tc0.x,  tc3.y )) * (w0.x  * w3.y);
    c += texture(src, vec2(tc12.x, tc3.y )) * (w12.x * w3.y);
    c += texture(src, vec2(tc3.x,  tc3.y )) * (w3.x  * w3.y);

    c = max(c, vec4(0.0));
    float lum = dot(c.rgb, vec3(0.299, 0.587, 0.114));
    imageStore(dst, p, vec4(c.rgb, lum));
}
